    {
      "parameters": {
        "jsCode": "const from = $json.From || \"\";\n\nconst match = from.match(/^(.*?)\\s*<([^>]+)>$/);\n\nconst customer_name = match ? match[1].trim() : from.trim();\nconst customer_email = match ? match[2].trim() : \"\";\n\nreturn {\n  json: {\n    customer_name,\n    customer_email,\n    subject: $json.Subject || \"\",\n    message: $json.snippet || \"\",\n    received_at: $json.internalDate || \"\",\n    message_id: $json.id || \"\"\n  }\n};"
      },
